{
  "name": "@tacet-ink/journal-core",
  "version": "0.3.0",
  "description": "Zero-knowledge journal core — e2e crypto, passphrase-only auth, transport, ratelimit. The server never sees plaintext.",
  "homepage": "https://tacet.ink",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/tacet-ink/journal-core.git"
  },
  "bugs": {
    "url": "https://github.com/tacet-ink/journal-core/issues"
  },
  "type": "module",
  "keywords": [
    "journal",
    "diary",
    "encryption",
    "e2ee",
    "end-to-end-encryption",
    "argon2id",
    "bip39",
    "passphrase",
    "zero-knowledge",
    "webcrypto",
    "privacy",
    "tacet"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client/note-crypto": {
      "types": "./dist/client/note-crypto.d.ts",
      "default": "./dist/client/note-crypto.js"
    },
    "./client/keys": {
      "types": "./dist/client/keys.d.ts",
      "default": "./dist/client/keys.js"
    },
    "./client/argon2": {
      "types": "./dist/client/argon2.d.ts",
      "default": "./dist/client/argon2.js"
    },
    "./client/pinlock": {
      "types": "./dist/client/pinlock.d.ts",
      "default": "./dist/client/pinlock.js"
    },
    "./client/bip39": {
      "types": "./dist/client/bip39.d.ts",
      "default": "./dist/client/bip39.js"
    },
    "./client/wordlist": {
      "types": "./dist/client/wordlist.d.ts",
      "default": "./dist/client/wordlist.js"
    },
    "./server/auth": {
      "types": "./dist/server/auth.d.ts",
      "default": "./dist/server/auth.js"
    },
    "./server/ratelimit": {
      "types": "./dist/server/ratelimit.d.ts",
      "default": "./dist/server/ratelimit.js"
    },
    "./server/cors": {
      "types": "./dist/server/cors.d.ts",
      "default": "./dist/server/cors.js"
    },
    "./server/hash": {
      "types": "./dist/server/hash.d.ts",
      "default": "./dist/server/hash.js"
    },
    "./server/env": {
      "types": "./dist/server/env.d.ts",
      "default": "./dist/server/env.js"
    },
    "./server/ladder": {
      "types": "./dist/server/ladder.d.ts",
      "default": "./dist/server/ladder.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "src",
    "scripts",
    "!scripts/generate-vectors.ts",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "verify": "node --experimental-strip-types scripts/verify-core-crypto.ts",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@scure/bip39": "^2.4.0",
    "typescript": "~7.0.2"
  }
}
