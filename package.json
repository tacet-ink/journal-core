{
  "name": "@tacet-ink/journal-core",
  "version": "0.2.1",
  "description": "Zero-knowledge journal core — e2e crypto, passphrase-only auth, transport, ratelimit. The server never sees plaintext.",
  "homepage": "https://tacet.ink",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/tacet-ink/journal-core.git"
  },
  "bugs": {
    "url": "https://github.com/tacet-ink/journal-core/issues"
  },
  "type": "module",
  "keywords": [
    "journal",
    "diary",
    "encryption",
    "e2ee",
    "end-to-end-encryption",
    "argon2id",
    "bip39",
    "passphrase",
    "zero-knowledge",
    "webcrypto",
    "privacy",
    "tacet"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./client/note-crypto": "./src/client/note-crypto.ts",
    "./client/keys": "./src/client/keys.ts",
    "./client/argon2": "./src/client/argon2.ts",
    "./client/pinlock": "./src/client/pinlock.ts",
    "./client/bip39": "./src/client/bip39.ts",
    "./client/wordlist": "./src/client/wordlist.ts",
    "./server/auth": "./src/server/auth.ts",
    "./server/ratelimit": "./src/server/ratelimit.ts",
    "./server/cors": "./src/server/cors.ts",
    "./server/hash": "./src/server/hash.ts",
    "./server/env": "./src/server/env.ts",
    "./server/ladder": "./src/server/ladder.ts"
  },
  "files": [
    "src",
    "scripts",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "verify": "node --experimental-strip-types scripts/verify-core-crypto.ts",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@scure/bip39": "^2.4.0",
    "typescript": "~7.0.2"
  }
}
